# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# netlify
.netlify
deno.lock

# typescript
*.tsbuildinfo
next-env.d.ts

# database
/prisma/dev.db
/prisma/dev.db-journal

# uploaded files
/storage/uploads/*
!/storage/uploads/.gitkeep

# ReinAI Code distributable binaries — deployed as static downloads directly
# via Netlify CLI, deliberately not committed to git (would bloat repo
# history with 80MB+ binaries on every version bump)
/public/downloads/*.exe
