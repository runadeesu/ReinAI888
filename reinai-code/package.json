{
  "name": "reinai-code",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "author": "ReinAI",
  "description": "ReinAI Code — a desktop AI pair-programmer that reads, edits, and runs commands in a local project folder.",
  "main": "dist/main/index.js",
  "scripts": {
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json",
    "build": "pnpm run build:renderer && pnpm run build:main",
    "start": "electron .",
    "dist:win": "pnpm run build && electron-builder --win"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.30",
    "@ai-sdk/google": "^4.0.34",
    "@ai-sdk/openai": "^4.0.30",
    "ai": "^7.0.52",
    "diff": "^9.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5",
    "vite": "^6.0.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-builder",
      "esbuild"
    ]
  },
  "build": {
    "appId": "com.reinai.code",
    "productName": "ReinAI Code",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
